# ==============================================================================
# Hirely AI - Backend Environment Configuration
# ==============================================================================

# TinyFish AI API Key (Get yours at https://agent.tinyfish.ai/api-keys)
# If left blank, the backend runs in Smart Mock & Curated Dataset mode.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Optional: Gemini / OpenAI API Key for Secondary AI Chat & Summarization
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# SMTP Email Service Configuration
# ==============================================================================
# Enables automated welcome emails and personalized opportunity recommendation digests.
# If SMTP_USER or SMTP_PASSWORD is left blank, the email service operates in
# "Simulated / Mock" mode (logging emails to console without throwing errors).

# Host and Port (e.g., smtp.gmail.com:587, smtp.sendgrid.net:587, smtp.mailgun.org:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Authentication Credentials
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Security Flags
SMTP_TLS=true
SMTP_SSL=false
SMTP_ENABLED=true

# Sender Identity
EMAILS_FROM_EMAIL=notifications@hirely.ai
EMAILS_FROM_NAME="Hirely AI"

# Automation Flags
# Automatically dispatches a welcome email whenever a new profile is created
SEND_WELCOME_EMAIL_ON_SIGNUP=true

# ==============================================================================
# Database & Network
# ==============================================================================
DATABASE_URL=sqlite+aiosqlite:///./hirely.db
