# Hirely AI Backend - Environment Configuration

# TinyFish AI API Key (Get yours at https://agent.tinyfish.ai/api-keys)
# If left empty, the server automatically operates in Smart Mock / Demo mode with rich curated data
TINYFISH_API_KEY=

# Optional secondary LLM API keys (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Connection (Defaults to SQLite in local project directory)
DATABASE_URL=sqlite+aiosqlite:///./hirely.db

# Fallback setting (true allows testing without API keys)
ENABLE_MOCK_FALLBACK=true
